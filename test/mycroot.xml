<root name="lateral" subType="2">
    <parameter name="gf" value="1"/>
    <!--Growth function number [1]-->
    <parameter name="tropismT" value="1"/>
    <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
    <parameter name="a" value="0.1"/>
    <!--radius [cm]-->
    <parameter name="dx" value="0.25"/>
    <!--Axial resolution [cm] (maximal segment size)-->
    <parameter name="dxMin" value="1e-06"/>
    <!--Axial resolution [cm] (minimal segment size)-->
    <parameter name="dx_inf" value="0.2"/>
    <!--Segment length for colonized root segments only in high resolution case [cm]-->
    <parameter name="hairsElongation" value="0"/>
    <!--Zone behind the tip without root hairs  [cm]-->
    <parameter name="hairsLength" value="0"/>
    <!--Root hair length [cm]-->
    <parameter name="hairsZone" value="0"/>
    <!--Length of the root hair zone [cm]-->
    <parameter name="highresolution" value="0"/>
    <!--If true, a hypha is created at every colonized node, otherwise hyphae are created based on hyphalEmergenceDensity-->
    <parameter name="hyphalDelay" value="0.5"/>
    <!--Delay time before hyphal emergence after colonization [day]-->
    <parameter name="hyphalEmergenceDensity" value="5"/>
    <!--Density of hyphal emergence along root [1/cm]-->
    <parameter name="la" value="1.5"/>
    <!--Apical zone [cm]-->
    <parameter name="lb" value="5.5"/>
    <!--Basal zone [cm]-->
    <parameter name="ldelay" value="5" dev="2"/>
    <!--Lateral root emergence delay [day]-->
    <parameter name="lmax" value="15.75"/>
    <!--Maximal root length [cm]-->
    <parameter name="lmbd" value="0.5"/>
    <!--Rate of primary colonization for dispersed inoculum [1/(cm day)]-->
    <parameter name="ln" value="1.25" dev="0.12"/>
    <!--Inter-lateral distance [cm]-->
    <parameter name="lnk" value="0"/>
    <!--Slope of inter-lateral distances [1]-->
    <parameter name="maxAge" value="10"/>
    <!--Maximal colonization age of a root segment [day]-->
    <parameter name="maxColonization" value="0.5"/>
    <!--Percentage of maximal colonization-->
    <parameter name="minAge" value="0.1"/>
    <!--Minimal susceptible age of a root segment [day]-->
    <parameter name="r" value="1"/>
    <!--Initial growth rate [cm day-1]-->
    <parameter name="rlt" value="1e+09"/>
    <!--Root life time [day]-->
    <parameter name="theta" value="1.22"/>
    <!--Angle between root and parent root [rad]-->
    <parameter name="tropismN" value="1"/>
    <!--Number of trials of root tropism-->
    <parameter name="tropismS" value="0.2"/>
    <!--Mean value of expected change of root tropism [1/cm]-->
    <parameter name="vi" value="0.5"/>
    <!--Rate of internal colonization [cm / day]-->
    <parameter name="successor" ruleId="0" subType="4, 5, 6" percentage="0.4, 0.1, 0.5"/>
    <!--Sub type of lateral -->
</root>
