<plant>
    <seed name="Daucus_carota" subType="0">
        <parameter name="delayDefinitionRoot" value="0"/>
        <!--method implemented to evaluate root lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->
        <parameter name="delayDefinitionShoot" value="2"/>
        <!--method implemented to evaluate shoot lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->
        <parameter name="maxTil" value="0"/>
        <!--Maximal number of tillers [1]-->
        <parameter name="a" value="0.1"/>
        <!--radius [cm]-->
        <parameter name="delayB" value="0"/>
        <!--Time delay between the basal roots [day]-->
        <parameter name="delayRC" value="1000"/>
        <!--Delay between the root crowns [day]-->
        <parameter name="delaySB" value="1000"/>
        <!--Time delay between the shoot borne roots [day]-->
        <parameter name="delayTil" value="1e+09"/>
        <!--Time delay between the tillers [day]-->
        <parameter name="dx" value="0.25"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="firstB" value="0"/>
        <!--Emergence of first basal root [day]-->
        <parameter name="firstSB" value="1000"/>
        <!--First emergence of a shoot borne root [day]-->
        <parameter name="firstTil" value="1e+09"/>
        <!--Emergence of first tiller [day]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->
        <parameter name="maxB" value="0"/>
        <!--Maximal number of basal roots [1]-->
        <parameter name="nC" value="0"/>
        <!--Maximal number of roots per root crown [1]-->
        <parameter name="nz" value="0"/>
        <!--Distance between the root crowns along the shoot [cm]-->
        <parameter name="seedPos.x" value="0"/>
        <!--X-Coordinate of seed position [cm]-->
        <parameter name="seedPos.y" value="0"/>
        <!--Y-Coordinate of seed position [cm]-->
        <parameter name="seedPos.z" value="-1"/>
        <!--Z-Coordinate of seed position [cm]-->
        <parameter name="simulationTime" value="100"/>
        <!--Recommended final simulation time  [day]-->
    </seed>
    <root name="taproot" subType="1">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        <parameter name="tropismT" value="1"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3) -> gravitropism-->
        <parameter name="a" value="0.1"/>
        <!--radius [cm], range: 0.1-0.30-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="10"/>
        <!--Apical zone [cm], range: 5-15-->
        <parameter name="lb" value="3.5"/>
        <!--Basal zone [cm], range: 2-5-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="185"/>
        <!--Maximal root length [cm], range: 150-220-->
        <parameter name="ln" value="3.5"/>
        <!--Inter-lateral (branching) distance [cm], range: 2-5-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="1.75"/>
        <!--Initial growth rate [cm day-1], range: 1.0-2.5-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="0"/>
        <!--Angle between root and parent root [rad], fixed at 0-->
        <parameter name="tropismN" value="2"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0.2"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="2" organType="2" percentage="1"/>
        <!--Sub type of lateral - taproot always forms 1st-order laterals-->
    </root>
    <root name="lateral1" subType="2">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        <parameter name="tropismT" value="0"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3) -> plagiotropism-->
        <parameter name="a" value="0.055"/>
        <!--radius [cm], range: 0.03-0.08-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="3.5"/>
        <!--Apical zone [cm], range: 2-5-->
        <parameter name="lb" value="1.25"/>
        <!--Basal zone [cm], range: 0.5-2-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="50"/>
        <!--Maximal root length [cm], range: 40-60-->
        <parameter name="ln" value="2"/>
        <!--Inter-lateral (branching) distance [cm], range: 1-3-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="1"/>
        <!--Initial growth rate [cm day-1], range: 0.5-1.5-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="1.2654"/>
        <!--Angle between root and parent root [rad], 72.5 deg, range: 60-85 deg (1.047-1.484 rad)-->
        <parameter name="tropismN" value="2"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0.3"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="3" organType="2" percentage="1"/>
        <!--Sub type of lateral - 1st-order laterals form 2nd-order laterals-->
    </root>
    <root name="lateral2" subType="3">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        <parameter name="tropismT" value="0"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3) -> plagiotropism-->
        <parameter name="a" value="0.02"/>
        <!--radius [cm], range: 0.01-0.03-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="2"/>
        <!--Apical zone [cm], range: 1-3-->
        <parameter name="lb" value="0.6"/>
        <!--Basal zone [cm], range: 0.2-1-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="12.5"/>
        <!--Maximal root length [cm], range: 5-20-->
        <parameter name="ln" value="0"/>
        <!--Inter-lateral (branching) distance [cm], not applicable - no 3rd-order laterals-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="0.5"/>
        <!--Initial growth rate [cm day-1], range: 0.2-0.8-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="1.0908"/>
        <!--Angle between root and parent root [rad], 62.5 deg, range: 45-80 deg (0.785-1.396 rad)-->
        <parameter name="tropismN" value="2"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0.3"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <!--no successor defined: none / low probability of further branching-->
    </root>
</plant>
