        <parameter name="a" value="0.0010175684088556" dev="0.00024665006549464547" />
        <!--radius [cm]: 50 um as in Schnepf et al. 2017 (runner hyphae only, BAS not simulated there); diameter > 20 um (Bago et al. 1998); dev without source-->
        <parameter name="ana" value="0.308240054307365" />
        <!--Probability of anastomosis occuring if distance is long enough; unknown, fusion does not always happen: nominal 0.7 inside the range 0.3-1 (not at the bound)-->
        <parameter name="b" value="0.7985039604547293" dev="0.02546719430539218" />
        <!--Branching rate [1/day]-->
        <parameter name="b_prob" value="0" />
        <!--Probability of branching to occur by tip splitting rather than lateral branching [1]-->
        <parameter name="distTH" value="0.0058558915405752" dev="0.00035485477424480893" />
        <!--Distance for tip-hyphae anastomosis [cm]: larger than the hyphal diameter, tips appear to sense other hyphae; ~100 um plausible, possibly more (Richter et al. 2024)-->
        <parameter name="anaMinDist" value="0.04534186364540009" />
        <!--Minimal path length along the mycelium for anastomosis [cm]; -1: derived, distTH / sin(theta) + 2 dx (about 0.03 cm), instead of the default 0.1 cm-->
