<?xml version='1.0' encoding='utf-8'?>
<!-- PLATZHALTER: durch das echte, vollständige Nominal-Parameterfile ersetzen -->
<plant name="template">
    <hyphae name="PullerHyphae" subType="1">
        <parameter name="tropismT" value="2"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        <parameter name="a" value="0.0050" dev="0.0005"/>
        <!--radius [cm]-->
        <parameter name="ana" value="1"/>
        <!--Probability of anastomosis occuring if distance is long enough-->
        <parameter name="b" value="0.95" dev="0.05"/>
        <!--Branching rate [1/day]-->
        <parameter name="b_prob" value="0"/>
        <!--Probability of branching to occur by tip splitting rather than lateral branching [1]-->
        <parameter name="distTH" value="0.02"/>
        <!--Distance for tip-hyphae anastomosis [cm]-->
        <parameter name="dx" value="0.01"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hlt" value="10" dev="2"/>
        <!--Hyphal lifetime  [day]-->
        <parameter name="la" value="0.01" dev="0.001"/>
        <!--Apical zone [cm]-->
        <parameter name="lb" value="0.4" dev="0.01"/>
        <!--Basal zone [cm]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->
        <parameter name="lmax" value="7" dev="3"/>
        <!--Maximal length of the hyphae [cm]-->
        <parameter name="ln" value="0.1" dev="0.01"/>
        <!--Inter-lateral distance [cm]-->
        <parameter name="theta" value="1.0471976" dev="0.10471976"/>
        <!--Branching angle [rad]-->
        <parameter name="tropismN" value="5"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0.5"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <parameter name="v" value="0.68" dev="0.06"/>
        <!--Tip elongation rate [cm/day]-->
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="2, 1" organType="6, 6" percentage="0.75, 0.25"/>
        <!--Sub type of lateral -->
    </hyphae>
    <hyphae name="RunnerHyphae" subType="2">
        <parameter name="tropismT" value="2"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        <parameter name="a" value="0.0050" dev="0.0005"/>
        <!--radius [cm]-->
        <parameter name="ana" value="1"/>
        <!--Probability of anastomosis occuring if distance is long enough-->
        <parameter name="b" value="24" dev="0.05"/>
        <!--Branching rate [1/day]-->
        <parameter name="b_prob" value="1"/>
        <!--Probability of branching to occur by tip splitting rather than lateral branching [1]-->
        <parameter name="distTH" value="0.02"/>
        <!--Distance for tip-hyphae anastomosis [cm]-->
        <parameter name="dx" value="0.01"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hlt" value="6" dev="2"/>
        <!--Hyphal lifetime  [day]-->
        <parameter name="la" value="0.01" dev="0.001"/>
        <!--Apical zone [cm]-->
        <parameter name="lb" value="0.4" dev="0.01"/>
        <!--Basal zone [cm]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->
        <parameter name="lmax" value="3" dev="0.3"/>
        <!--Maximal length of the hyphae [cm]-->
        <parameter name="ln" value="0.1" dev="0.01"/>
        <!--Inter-lateral distance [cm]-->
        <parameter name="theta" value="1.0471976" dev="0.10471976"/>
        <!--Branching angle [rad]-->
        <parameter name="tropismN" value="5"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="1.0"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <parameter name="v" value="0.60" dev="0.06"/>
        <!--Tip elongation rate [cm/day]-->
    </hyphae>
</plant>
